# Parler repo root — copy to `.env` (gitignored). Used by `test_scripts/` (uv run …).

# --- dev_import_control / reset_dev (optional Composer automation) ---
# DEV_SERVER=https://your-host/Thingworx
# DEV_KEY=<application-key>
# SSH_REMOTE_HOST=

# --- agent-eval (uv run agent-eval --agent-matrix env) ---
# DEV_SERVER / DEV_KEY as above. Map suite agentMatrix labels to your AgentThing names, for example:
# AGENT_EVAL_AGENT_GPT_5_5=SCPA_Demo_Agent            (suites under docs/agent/evals)
# AGENT_EVAL_AGENT_GPT_5_4=Customer_Agent_GPT54       (training eval pack)
# AGENT_EVAL_AGENT_SONNET_4_6=Customer_Agent_Sonnet46 (training eval pack)
# Optional fixture gates used by the training eval pack (training/workshop/day4/eval/customer-evals):
# CUSTOMER_HAS_EMPTY_DATATABLE=
# CUSTOMER_HAS_HISTORY=
# CUSTOMER_HAS_PROTECTED_FIXTURE=
# CUSTOMER_HAS_NO_ALERT_PAIR=
