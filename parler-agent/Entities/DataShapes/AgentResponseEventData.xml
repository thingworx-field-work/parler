<?xml version="1.0" encoding="UTF-8"?>
<Entities>
    <DataShapes>
        <DataShape name="AgentResponseEventData"
                   description="Data shape for AgentResponseEvent">
            <FieldDefinitions>
                <FieldDefinition name="conversationId" baseType="STRING"
                                 description="Conversation ID" ordinal="0"/>
                <FieldDefinition name="response" baseType="TEXT"
                                 description="Agent's text response" ordinal="1"/>
                <FieldDefinition name="status" baseType="STRING"
                                 description="Terminal status: SUCCESS, ERROR, TIMEOUT, MAX_ITERATIONS, AWAITING_APPROVAL, or CANCELLED" ordinal="2"/>
                <FieldDefinition name="iterations" baseType="INTEGER"
                                 description="Number of agent loop iterations" ordinal="3"/>
                <FieldDefinition name="promptTokens" baseType="INTEGER"
                                 description="Total prompt tokens consumed" ordinal="4"/>
                <FieldDefinition name="completionTokens" baseType="INTEGER"
                                 description="Total completion tokens consumed" ordinal="5"/>
                <FieldDefinition name="errorCode" baseType="STRING"
                                 description="Optional stable public error code when status is ERROR" ordinal="6"/>
            </FieldDefinitions>
        </DataShape>
    </DataShapes>
</Entities>
