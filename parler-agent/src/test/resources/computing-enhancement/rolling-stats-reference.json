{
  "method": "rolling_stats_v1",
  "note": "records are [secondsFromStart, value-or-null]; expected is one [value-or-null, valueStatus, support, records, warmedUp] per record in order",
  "cases": [
    {"name": "card: two-observation sum", "statistic": "sum", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[0, 1], [60, 3], [120, 5]],
     "expected": [[1, "OK", 1, 1, false], [4, "OK", 2, 2, true], [8, "OK", 2, 2, true]]},
    {"name": "card: minSupport 2 leaves the first value empty", "statistic": "sum", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 2,
     "records": [[0, 1], [60, 3], [120, 5]],
     "expected": [[null, "BELOW_MIN_SUPPORT", 1, 1, false], [4, "OK", 2, 2, true], [8, "OK", 2, 2, true]]},
    {"name": "sample stddev of two values", "statistic": "stddev", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[0, 1], [60, 3]],
     "expected": [[null, "BELOW_MIN_SAMPLE", 1, 1, false], [1.4142135623730951, "OK", 2, 2, true]]},
    {"name": "mean", "statistic": "mean", "kind": "OBSERVATION_COUNT", "observationWindow": 3, "minSupport": 1,
     "records": [[0, 2], [60, 4], [120, 9]],
     "expected": [[2, "OK", 1, 1, false], [3, "OK", 2, 2, false], [5, "OK", 3, 3, true]]},
    {"name": "min", "statistic": "min", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[0, 5], [60, 2], [120, 7]],
     "expected": [[5, "OK", 1, 1, false], [2, "OK", 2, 2, true], [2, "OK", 2, 2, true]]},
    {"name": "max", "statistic": "max", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[0, 5], [60, 2], [120, 7]],
     "expected": [[5, "OK", 1, 1, false], [5, "OK", 2, 2, true], [7, "OK", 2, 2, true]]},

    {"name": "matrix [null,null]: count_records", "statistic": "count_records", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[0, null], [60, null]],
     "expected": [[1, "OK", 0, 1, false], [2, "OK", 0, 2, true]]},
    {"name": "matrix [null,null]: count_values is a measured zero", "statistic": "count_values", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[0, null], [60, null]],
     "expected": [[0, "OK", 0, 1, false], [0, "OK", 0, 2, true]]},
    {"name": "matrix [null,null]: an all-missing sum is empty, not zero", "statistic": "sum", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[0, null], [60, null]],
     "expected": [[null, "BELOW_MIN_SUPPORT", 0, 1, false], [null, "BELOW_MIN_SUPPORT", 0, 2, true]]},
    {"name": "matrix [null,3]: sum", "statistic": "sum", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[0, null], [60, 3]],
     "expected": [[null, "BELOW_MIN_SUPPORT", 0, 1, false], [3, "OK", 1, 2, true]]},
    {"name": "matrix [null,3]: stddev lacks a second value", "statistic": "stddev", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[0, null], [60, 3]],
     "expected": [[null, "BELOW_MIN_SUPPORT", 0, 1, false], [null, "BELOW_MIN_SAMPLE", 1, 2, true]]},
    {"name": "matrix [null,3] minSupport 2: value statistics gate on valid values", "statistic": "mean", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 2,
     "records": [[0, null], [60, 3]],
     "expected": [[null, "BELOW_MIN_SUPPORT", 0, 1, false], [null, "BELOW_MIN_SUPPORT", 1, 2, true]]},
    {"name": "matrix [null,3] minSupport 2: counts gate on records", "statistic": "count_values", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 2,
     "records": [[0, null], [60, 3]],
     "expected": [[null, "BELOW_MIN_SUPPORT", 0, 1, false], [1, "OK", 1, 2, true]]},

    {"name": "elapsed: the record exactly at t-D is a member", "statistic": "sum", "kind": "ELAPSED_DURATION", "durationWindowSeconds": 60, "minSupport": 1,
     "records": [[0, 1], [60, 3], [121, 5]],
     "expected": [[1, "OK", 1, 1, false], [4, "OK", 2, 2, true], [5, "OK", 1, 1, true]]},
    {"name": "elapsed ties follow the stable prefix: 1, 4, 9", "statistic": "sum", "kind": "ELAPSED_DURATION", "durationWindowSeconds": 60, "minSupport": 1,
     "records": [[0, 1], [60, 3], [60, 5]],
     "expected": [[1, "OK", 1, 1, false], [4, "OK", 2, 2, true], [9, "OK", 3, 3, true]]},
    {"name": "sparse: warmedUp is not coverage", "statistic": "count_records", "kind": "ELAPSED_DURATION", "durationWindowSeconds": 3600, "minSupport": 1,
     "records": [[0, 10], [7200, 12]],
     "expected": [[1, "OK", 1, 1, false], [1, "OK", 1, 1, true]]},
    {"name": "internal gap: warmed up with one record in the window", "statistic": "mean", "kind": "ELAPSED_DURATION", "durationWindowSeconds": 600, "minSupport": 1,
     "records": [[0, 1], [60, 2], [36000, 9]],
     "expected": [[1, "OK", 1, 1, false], [1.5, "OK", 2, 2, false], [9, "OK", 1, 1, true]]},
    {"name": "full-size window of null values: warmed up, zero support", "statistic": "mean", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[0, null], [60, null]],
     "expected": [[null, "BELOW_MIN_SUPPORT", 0, 1, false], [null, "BELOW_MIN_SUPPORT", 0, 2, true]]},
    {"name": "out-of-order input is sorted", "statistic": "sum", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 1,
     "records": [[120, 5], [0, 1], [60, 3]],
     "expected": [[1, "OK", 1, 1, false], [4, "OK", 2, 2, true], [8, "OK", 2, 2, true]]},

    {"name": "numeric: large same sign mean", "statistic": "mean", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 2,
     "records": [[0, 1e150], [60, 1e150]], "expected": [[null, "BELOW_MIN_SUPPORT", 1, 1, false], [1e150, "OK", 2, 2, true]]},
    {"name": "numeric: large same sign sum", "statistic": "sum", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 2,
     "records": [[0, 1e150], [60, 1e150]], "expected": [[null, "BELOW_MIN_SUPPORT", 1, 1, false], [2e150, "OK", 2, 2, true]]},
    {"name": "numeric: large same sign stddev is exactly zero", "statistic": "stddev", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 2,
     "records": [[0, 1e150], [60, 1e150]], "expected": [[null, "BELOW_MIN_SUPPORT", 1, 1, false], [0, "OK", 2, 2, true]]},
    {"name": "numeric: large opposite sign mean", "statistic": "mean", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 2,
     "records": [[0, -1e150], [60, 1e150]], "expected": [[null, "BELOW_MIN_SUPPORT", 1, 1, false], [0, "OK", 2, 2, true]]},
    {"name": "numeric: large opposite sign stddev", "statistic": "stddev", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 2, "relativeTolerance": 1e-15,
     "records": [[0, -1e150], [60, 1e150]], "expected": [[null, "BELOW_MIN_SUPPORT", 1, 1, false], [1.4142135623730951e150, "OK", 2, 2, true]]},
    {"name": "numeric: constant 0.1 mean", "statistic": "mean", "kind": "OBSERVATION_COUNT", "observationWindow": 3, "minSupport": 3,
     "records": [[0, 0.1], [60, 0.1], [120, 0.1]], "expected": [[null, "BELOW_MIN_SUPPORT", 1, 1, false], [null, "BELOW_MIN_SUPPORT", 2, 2, false], [0.1, "OK", 3, 3, true]]},
    {"name": "numeric: constant 0.1 stddev is exactly zero", "statistic": "stddev", "kind": "OBSERVATION_COUNT", "observationWindow": 3, "minSupport": 3,
     "records": [[0, 0.1], [60, 0.1], [120, 0.1]], "expected": [[null, "BELOW_MIN_SUPPORT", 1, 1, false], [null, "BELOW_MIN_SUPPORT", 2, 2, false], [0, "OK", 3, 3, true]]},
    {"name": "numeric: small non-constant stddev does not underflow to zero", "statistic": "stddev", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 2, "relativeTolerance": 1e-15,
     "records": [[0, -1e-200], [60, 1e-200]], "expected": [[null, "BELOW_MIN_SUPPORT", 1, 1, false], [1.414213562373095e-200, "OK", 2, 2, true]]},
    {"name": "numeric: small constant stddev is exactly zero", "statistic": "stddev", "kind": "OBSERVATION_COUNT", "observationWindow": 2, "minSupport": 2,
     "records": [[0, 1e-200], [60, 1e-200]], "expected": [[null, "BELOW_MIN_SUPPORT", 1, 1, false], [0, "OK", 2, 2, true]]}
  ]
}
