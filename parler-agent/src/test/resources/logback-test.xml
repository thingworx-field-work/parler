<?xml version="1.0" encoding="UTF-8"?>
<!-- Override TW platform logback.xml in tests: platform-common's logback registers listeners
     that require classes (e.g. ProviderConfig) not on the JUnit classpath. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
