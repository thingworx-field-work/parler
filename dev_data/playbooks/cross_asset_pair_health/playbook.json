{
  "schema": "parler-playbook-v1",
  "id": "cross_asset_pair_health",
  "title": "Cross asset pair health comparison",
  "description": "Compare current health and recent numeric trends for two assets of the same type identified by name, display name, or serial number.",
  "whenToUse": "Use when the user asks to compare two individual assets of the same asset type by identifier.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "assetType": {
        "type": "string"
      },
      "assetIdentifierA": {
        "type": "string"
      },
      "assetIdentifierB": {
        "type": "string"
      },
      "timeWindow": {
        "type": "string"
      }
    },
    "required": [
      "assetType",
      "assetIdentifierA",
      "assetIdentifierB"
    ]
  },
  "execution": {
    "timeoutSeconds": 900,
    "maxNodes": 80,
    "maxToolCalls": 200,
    "maxEvidenceBytes": 12000
  },
  "budgets": {
    "timeoutSeconds": 900,
    "maxNodes": 80,
    "maxToolCalls": 200,
    "maxEvidenceBytes": 12000
  },
  "vars": {},
  "nodes": [
    {
      "id": "taxonomy_row",
      "kind": "derive",
      "dependsOn": [],
      "op": "pick_taxonomy_row",
      "args": {
        "assetType": {
          "$input": "assetType"
        },
        "taxonomyRows": {
          "$var": "assetTaxonomy.rows"
        }
      },
      "evidence": {
        "label": "Resolve asset type from taxonomy"
      }
    },
    {
      "id": "list_candidates",
      "kind": "tool_call",
      "dependsOn": [
        "taxonomy_row"
      ],
      "tool": "query_entities_by_taxonomy",
      "args": {
        "EntityType": {
          "$var": "taxonomy.EntityType"
        },
        "EntityName": {
          "$var": "taxonomy.EntityName"
        },
        "CriticalProperties": {
          "$var": "taxonomy.CriticalProperties"
        }
      },
      "evidence": {
        "label": "List candidate Things for asset type"
      }
    },
    {
      "id": "match_asset_a",
      "kind": "derive",
      "dependsOn": [
        "list_candidates"
      ],
      "op": "match_entity_identifiers",
      "args": {
        "identifier": {
          "$input": "assetIdentifierA"
        },
        "label": "asset A",
        "candidatesNodeId": "list_candidates"
      },
      "evidence": {
        "label": "Match first asset identifier"
      }
    },
    {
      "id": "require_exact_a",
      "kind": "derive",
      "dependsOn": [
        "match_asset_a"
      ],
      "op": "require_exact_count",
      "args": {
        "matchNodeId": "match_asset_a"
      },
      "evidence": {
        "label": "Confirm single match for asset A"
      }
    },
    {
      "id": "match_asset_b",
      "kind": "derive",
      "dependsOn": [
        "list_candidates"
      ],
      "op": "match_entity_identifiers",
      "args": {
        "identifier": {
          "$input": "assetIdentifierB"
        },
        "label": "asset B",
        "candidatesNodeId": "list_candidates"
      },
      "evidence": {
        "label": "Match second asset identifier"
      }
    },
    {
      "id": "require_exact_b",
      "kind": "derive",
      "dependsOn": [
        "match_asset_b"
      ],
      "op": "require_exact_count",
      "args": {
        "matchNodeId": "match_asset_b"
      },
      "evidence": {
        "label": "Confirm single match for asset B"
      }
    },
    {
      "id": "pair_assets",
      "kind": "derive",
      "dependsOn": [
        "require_exact_a",
        "require_exact_b"
      ],
      "op": "flatten_pair_assets",
      "args": {
        "matchNodeA": "match_asset_a",
        "matchNodeB": "match_asset_b"
      },
      "evidence": {
        "label": "Resolve asset pair"
      }
    },
    {
      "id": "alert_thing_names",
      "kind": "derive",
      "dependsOn": [
        "pair_assets"
      ],
      "op": "collect_thing_names_from_assets",
      "args": {
        "assetsRef": "pair_assets.output.assets",
        "maxNames": 25
      },
      "evidence": {
        "label": "Collect Thing names for alert comparison"
      }
    },
    {
      "id": "alerts_by_pair",
      "kind": "tool_call",
      "dependsOn": [
        "alert_thing_names"
      ],
      "tool": "query_alert_summary",
      "args": {
        "thingNames": {
          "$ref": "alert_thing_names.output.names"
        },
        "ackState": "all",
        "limit": 100
      },
      "evidence": {
        "label": "Read current alert summaries (multi-Thing)",
        "include": [
          "status",
          "resultKind",
          "completeness",
          "thingsRequested",
          "thingsSucceeded"
        ]
      }
    },
    {
      "id": "alert_groups",
      "kind": "derive",
      "dependsOn": [
        "alerts_by_pair",
        "pair_assets"
      ],
      "op": "group_alerts_by_source_property",
      "args": {
        "assetsRef": "pair_assets.output.assets",
        "alertSummaryNodeId": "alerts_by_pair"
      },
      "evidence": {
        "label": "Group alerts by source property"
      }
    },
    {
      "id": "primary_property",
      "kind": "derive",
      "dependsOn": [
        "alert_groups"
      ],
      "op": "select_primary_problem_property",
      "args": {
        "alertGroupsRef": "alert_groups.output.groups"
      },
      "evidence": {
        "label": "Select primary problem property"
      }
    },
    {
      "id": "property_union",
      "kind": "derive",
      "dependsOn": [
        "taxonomy_row",
        "primary_property",
        "alert_groups"
      ],
      "op": "union_property_names",
      "args": {
        "criticalProperties": {
          "$var": "taxonomy.CriticalPropertiesList"
        },
        "primaryProperty": {
          "$ref": "primary_property.output.primaryProperty"
        },
        "alertGroups": {
          "$ref": "alert_groups.output.groups"
        }
      },
      "evidence": {
        "label": "Build bounded property read list"
      }
    },
    {
      "id": "values_by_asset",
      "kind": "fan_out",
      "dependsOn": [
        "property_union",
        "pair_assets"
      ],
      "items": {
        "$ref": "pair_assets.output.assets"
      },
      "itemVar": "asset",
      "maxItems": 2,
      "maxConcurrency": 1,
      "node": {
        "kind": "tool_call",
        "tool": "get_property_values",
        "args": {
          "thingName": {
            "$item": "name"
          },
          "propertyNames": {
            "$var": "propertyUnion.names"
          }
        },
        "evidence": {
          "label": "Read current operational properties"
        }
      }
    },
    {
      "id": "trend_targets",
      "kind": "derive",
      "dependsOn": [
        "primary_property",
        "pair_assets"
      ],
      "op": "trend_targets",
      "args": {
        "primaryNodeId": "primary_property",
        "assets": {
          "$ref": "pair_assets.output.assets"
        }
      },
      "evidence": {
        "label": "Plan numeric trend reads"
      }
    },
    {
      "id": "trends_by_asset",
      "kind": "fan_out",
      "dependsOn": [
        "trend_targets"
      ],
      "items": {
        "$ref": "trend_targets.output.targets"
      },
      "itemVar": "target",
      "maxItems": 2,
      "maxConcurrency": 1,
      "node": {
        "kind": "tool_call",
        "tool": "query_property_history",
        "args": {
          "thingName": {
            "$item": "thingName"
          },
          "propertyName": {
            "$item": "propertyName"
          },
          "relativeDuration": {
            "$item": "relativeDuration"
          },
          "actions": [
            "FIRST",
            "LAST",
            "MIN",
            "MAX",
            "MEAN"
          ]
        },
        "evidence": {
          "label": "Read numeric property history"
        }
      }
    },
    {
      "id": "trend_summary",
      "kind": "derive",
      "dependsOn": [
        "trends_by_asset"
      ],
      "op": "trend_summary",
      "args": {
        "trendsFanOutNodeId": "trends_by_asset"
      },
      "evidence": {
        "label": "Compact per-asset trend evidence"
      }
    },
    {
      "id": "pair_summary",
      "kind": "derive",
      "dependsOn": [
        "pair_assets",
        "alert_groups",
        "primary_property",
        "values_by_asset",
        "trend_summary"
      ],
      "op": "summarize_asset_pair_health",
      "args": {
        "assets": {
          "$ref": "pair_assets.output.assets"
        },
        "alertGroupsNodeId": "alert_groups",
        "primaryNodeId": "primary_property",
        "alertsFanOutNodeId": "alerts_by_pair",
        "valuesFanOutNodeId": "values_by_asset"
      },
      "evidence": {
        "label": "Summarize pair health evidence"
      }
    },
    {
      "id": "final_summary",
      "kind": "llm_summary",
      "dependsOn": [
        "pair_summary"
      ],
      "prompt": "Write a concise asset-pair health comparison. Compare the two resolved assets using alert, current-value, and trend evidence. Note which asset appears less healthy and why, reference charts when trend evidence is present, and list evidence gaps. Use only the provided playbook evidence.",
      "evidenceRefs": [
        "taxonomy_row",
        "pair_assets",
        "alert_groups",
        "primary_property",
        "trend_summary",
        "pair_summary"
      ],
      "maxEvidenceBytes": 8000
    }
  ],
  "finalNode": "final_summary"
}
