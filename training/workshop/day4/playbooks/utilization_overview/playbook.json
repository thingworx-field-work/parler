{
  "schema": "parler-playbook-v1",
  "id": "utilization_overview",
  "title": "Utilization overview",
  "description": "Cross-machine utilization overview using the LLM-friendly overview tool.",
  "whenToUse": "Use when the user asks for an overview across machines, coverage, or fleet-level state aggregation with date context.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "startDate": {
        "type": "string"
      },
      "endDate": {
        "type": "string"
      },
      "shiftId": {
        "type": "string"
      }
    },
    "required": [
      "startDate",
      "endDate"
    ]
  },
  "execution": {
    "timeoutSeconds": 900,
    "maxNodes": 10,
    "maxToolCalls": 4,
    "maxEvidenceBytes": 12000
  },
  "budgets": {
    "timeoutSeconds": 900,
    "maxNodes": 10,
    "maxToolCalls": 4,
    "maxEvidenceBytes": 12000
  },
  "vars": {},
  "nodes": [
    {
      "id": "overview",
      "kind": "tool_call",
      "dependsOn": [],
      "tool": "get_utilization_overview",
      "args": {
        "StartDate": {
          "$input": "startDate"
        },
        "EndDate": {
          "$input": "endDate"
        },
        "ShiftID": {
          "$input": "shiftId"
        }
      },
      "evidence": {
        "label": "Read utilization overview",
        "includeToolOutputPaths": [
          "result.stats.utilizationPercent",
          "result.stats.eventCount",
          "result.machineCoverage.returnedRows"
        ],
        "table": {
          "path": "result.stateSummary.rows",
          "columns": [
            "utilizationState",
            "percentage",
            "count",
            "sumDurationHours"
          ],
          "maxRows": 8
        }
      }
    },
    {
      "id": "final_summary",
      "kind": "llm_summary",
      "dependsOn": [
        "overview"
      ],
      "prompt": "Write a concise utilization overview across machines over the requested time range. Include machine coverage, date-window caveats, state-level utilization aggregation, and evidence gaps. Use only the provided playbook evidence.",
      "evidenceRefs": [
        "overview"
      ],
      "maxEvidenceBytes": 8000
    }
  ],
  "finalNode": "final_summary"
}
